            "h": 0.07
          }
        ],
        "readingOrder": [
          "question",
          "leftEvidence",
          "rightEvidence",
          "interpretation",
          "caption"
        ],
        "compositionRule": "equal_windows_shared_axes_and_visible_status"
      },
      "portrait": {
        "referenceSize": {
          "width": 1080,
